{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bixbo",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  }
}
